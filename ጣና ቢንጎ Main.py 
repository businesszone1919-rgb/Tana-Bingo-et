@app.post("/webhook")
async def telegram_webhook(request: Request):
    try:
        data = await request.json()
        update = Update.de_json(data, bot)
        await telegram_app.process_update(update)
        return {"status": "success"}
    except Exception as e:
        return JSONResponse(status_code=400, content={"error": str(e)})

@app.get("/api/user-status")
async def get_user_status(initData: str = Query(...)):
    user_info = verify_telegram_init_data(initData, TOKEN)
    if not user_info: raise HTTPException(status_code=401, detail="Unauthorized")
    user_id = user_info.get("id")
    balance = USER_WALLETS.get(user_id, 500.0)
    USER_WALLETS[user_id] = balance
    return {"name": user_info.get("first_name"), "balance": balance, "game_info": LIVE_GAME}

@app.post("/api/buy-cartela")
async def buy_cartela(request: Request):
    body = await request.json()
    user_info = verify_telegram_init_data(body.get("initData"), TOKEN)
    if not user_info: raise HTTPException(status_code=401, detail="Unauthorized")
    
    user_id = user_info.get("id")
    cartela_no = int(body.get("cartela_no", 1))
    
    current_balance = USER_WALLETS.get(user_id, 500.0)
    if current_balance < 10.0:
        return JSONResponse(status_code=400, content={"success": False, "message": "በቂ የሂሳብ መጠን የለዎትም!"})
        
    USER_WALLETS[user_id] = current_balance - 10.0
    
    # ለካርታው ቁጥር ዩኒክ የቢንጎ ግሪድ ማመንጨት (Seed የተደረገው በካርታው ቁጥር ነው)
    random.seed(cartela_no)
    b = random.sample(range(1, 16), 5)
    i = random.sample(range(16, 31), 5)
    n = random.sample(range(31, 46), 5)
    g = random.sample(range(46, 61), 5)
    o = random.sample(range(61, 76), 5)
    
    grid = []
    for r in range(5):
        grid.extend([b[r], i[r], "⭐" if r == 2 else n[r], g[r], o[r]])
        
    random.seed() # Seedን መልሶ ነፃ ማድረግ
    return {"success": True, "new_balance": USER_WALLETS[user_id], "card": grid}

